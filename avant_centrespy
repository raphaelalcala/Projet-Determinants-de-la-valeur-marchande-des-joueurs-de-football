import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import statsmodels.api as sm

df=pd.read_csv("avant_centre_notes.csv")
print(df.info())

f_A = df[df["Poste"].isin([
    "Avant-centre"
])]

f_A["log_val"] = np.log(f_A["Valeur marchande(mio)"])

X = f_A[["Age","goals","assists"]]
y = f_A["log_val"]

X = sm.add_constant(X)

model = sm.OLS(y, X).fit()

print(model.summary())
