import pandas as pd
import numpy as np
import statsmodels.api as sm
from sklearn.preprocessing import StandardScaler

df = pd.read_csv("Gardiens.csv")

f_M = df[df["Poste"].isin(["Gardien de but"])].copy()

f_M["log_val"] = np.log(f_M["Valeur marchande(mio)"])

f_M["Age_c"]  = f_M["Age"] - f_M["Age"].mean()
f_M["Age_c2"] = f_M["Age_c"] ** 2

features = ["Age_c","Age_c2","CS"] #aucunes autres variables significatives
y = f_M["log_val"]

scaler = StandardScaler()
X_scaled = pd.DataFrame(
    scaler.fit_transform(f_M[features]),
    columns=features,
    index=f_M.index
)
X_scaled = sm.add_constant(X_scaled)

model = sm.OLS(y, X_scaled).fit()
print(model.summary())

from statsmodels.stats.diagnostic import het_breuschpagan
from statsmodels.stats.outliers_influence import variance_inflation_factor
bp = het_breuschpagan(model.resid, model.model.exog)
print(f"Breusch-Pagan p-value : {bp[1]:.4f}")


for i, col in enumerate(["const"] + features):
    vif = variance_inflation_factor(model.model.exog, i)
    print(f"VIF {col:25s} : {vif:.2f}")

